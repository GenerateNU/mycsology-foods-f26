{
    "cmake.sourceDirectory": "${workspaceFolder}/app",
    "clangd.path": "/usr/bin/clangd",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}/app",
        "--query-driver=/Users/rohandutta/zephyr-sdk-0.16.8/**/arm-zephyr-eabi-*",
        "--background-index",
        "--header-insertion=never"
    ],
    "clangd.detectExtensionConflicts": false,
    "clangd.onConfigChanged": "restart",
    "code-runner.runInTerminal": true,
    "code-runner.executorMapByFileExtension": {
        ".c": "echo 'Use west build for Zephyr C files; host gcc cannot resolve zephyr headers.'",
        ".h": "echo 'Use west build for Zephyr headers.'"
    },
    "files.associations": {
        "*.h": "c",
        "*.c": "c"
    },
    "[c]": {
        "editor.defaultFormatter": null
    },
    "terminal.integrated.env.osx": {
        "ZEPHYR_BASE": "/Users/rohandutta/mycology-workspace/zephyr",
        "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
        "ZEPHYR_SDK_INSTALL_DIR": "/Users/rohandutta/zephyr-sdk-0.16.8",
        "PATH": "/Users/rohandutta/Myscology_Foods/.venv/bin:${env:PATH}"
    }
}
