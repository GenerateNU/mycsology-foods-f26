/ {
    buzzer: buzzer {
        compatible = "pwm-buzzer";
        /* TIM8 CH1 on PC6 (Feather D6). Period is only a default; the driver changes it per tone. */
        pwms = <&pwm8 1 PWM_HZ(2700) PWM_POLARITY_NORMAL>;
    };

    pwmleds {
        compatible = "pwm-leds";
        fan_pwm: fan_pwm {
            pwms = <&pwm4 3 PWM_USEC(40) PWM_POLARITY_INVERTED>;
        };
        heater_pwm: heater_pwm {
            pwms = <&pwm11 1 PWM_MSEC(2000) PWM_POLARITY_NORMAL>;
        };
    };

    /*
    buttons {
        compatible = "gpio-keys";
        button_0: button_0 {
            gpios = <&gpioc 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; // ui button, PC7 (Feather D5)
        };
        button_1: button_1 {
            gpios = <&gpioc 3 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; // start button, PC3 (Feather D11)
        };
        button_2: button_2 {
            gpios = <&gpioc 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; // mix button, PC2 (Feather D12)
        };
    };
    */

    limit_switches {
        compatible = "gpio-keys";
        limit_switch_0: limit_switch_0 {
            gpios = <&gpioc 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; // limit switch, PC7 (Feather D5)
        };
    };

    stepper: stepper {
        compatible = "zephyr,gpio-step-dir-stepper-ctrl";
        step-gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;   // STEP pin A1
        dir-gpios  = <&gpioc 4 GPIO_ACTIVE_HIGH>;   // DIR pin A4
        status = "okay";
    };

    mover_stepper: mover_stepper {
        compatible = "zephyr,gpio-step-dir-stepper-ctrl";
        step-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;   // STEP pin D11 (PC3)
        dir-gpios  = <&gpioc 2 GPIO_ACTIVE_HIGH>;   // DIR pin D12 (PC2)
        status = "okay";
    };

    aliases {
        // b0 = &button_0;
        // b1 = &button_1;
        // b2 = &button_2;
        led2 = &ext_led;
        fan-pwm = &fan_pwm;
        heater-pwm = &heater_pwm;
        stepper = &stepper;
        mover-stepper = &mover_stepper;
        limit-sw = &limit_switch_0;
    };
};

&{/leds} {
    ext_led: led_2 {
        gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>; // PA4 (Feather A0)
    };
};

&timers8 {
    /* TIM8 runs from the 168 MHz APB2 timer clock: 168 MHz / (99+1) = 1.68 MHz tick.
     * Good pitch resolution, and tones down to ~26 Hz still fit in the 16-bit counter. */
    st,prescaler = <99>;
    status = "okay";

    pwm8: pwm {
        pinctrl-0 = <&tim8_ch1_pc6>;   /* D6 */
        pinctrl-names = "default";
        status = "okay";
    };
};

&timers3 {
    status = "okay";

    qdec: qdec {
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pa6 &tim3_ch2_pa7>;   /* A2, A3 */
        pinctrl-names = "default";
        st,input-filter-level = <FDIV32_N8>;
        st,counts-per-revolution = <24>;
    };
};

&timers4 {
    status = "okay";
    st,prescaler = <83>;   /* 84 MHz / (83+1) = 1 MHz tick */

    pwm4: pwm {
        status = "okay";
        pinctrl-0 = <&tim4_ch3_pb8>;   /* D9 */
        pinctrl-names = "default";
    };
};

&timers11 {
    status = "okay";
    st,prescaler = <83>;   /* 84 MHz / (83+1) = 1 MHz tick */

    pwm11: pwm {
        status = "okay";
        pinctrl-0 = <&tim11_ch1_pb9>;   /* D10 */
        pinctrl-names = "default";
    };
};

&i2c1 {
    status = "okay";
    /* Feather's labeled SCL/SDA pins (also the STEMMA QT port). PB8/PB9 are used by the fan PWM. */
    pinctrl-0 = <&i2c1_scl_pb6 &i2c1_sda_pb7>;
    pinctrl-names = "default";
    clock-frequency = <I2C_BITRATE_STANDARD>;   /* 100 kHz */

    ht16k33: ht16k33@70 {
        compatible = "holtek,ht16k33";
        reg = <0x70>;
    };
};

&tim3_ch1_pa6 { bias-pull-up; };   /* A2: encoder A */
&tim3_ch2_pa7 { bias-pull-up; };   /* A3: encoder B */
